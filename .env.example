# NovaArb phase 1 uses public Binance market-data streams only.
# No API key is required.
#
# Future live-trading credentials must NEVER be committed.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

NOVAARB_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
NOVAARB_TARGET_NOTIONAL_USDT=50
NOVAARB_MIN_NET_EDGE_BPS=2.0
NOVAARB_MAX_BOOK_AGE_MS=750
NOVAARB_LATENCY_RESERVE_BPS=0.75
NOVAARB_SPOT_TAKER_FEE_BPS=10
NOVAARB_FUTURES_TAKER_FEE_BPS=5
